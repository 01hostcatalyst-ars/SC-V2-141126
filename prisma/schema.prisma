// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  CREATOR
  BRAND
  AGENCY
}

enum PartyType {
  INITIATOR
  RESPONDENT
}

enum ContractType {
  CREATOR_TO_BRAND
  BRAND_TO_CREATOR
  BRAND_TO_AGENCY
  AGENCY_TO_BRAND
  AGENCY_TO_CREATOR
  CREATOR_TO_AGENCY
}

enum ContractStatus {
  DRAFT
  PENDING_RESPONDENT
  PENDING_INITIATOR
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

enum UsageType {
  ORGANIC_ONLY
  PAID_AD
  BILLBOARD_PRINT
  ALL_MEDIA
}

enum PaymentMethod {
  BANK_IBAN
  JAZZCASH
  EASYPAISA
  WIRE_TRANSFER
  ACH_ROUTING
  PAYPAL
  WISE
  SEPA
  LOCAL_MOBILE_WALLET
  CREDIT_DEBIT_CARD
}

enum CurrencyCode {
  USD
  EUR
  GBP
  AED
  SAR
  CAD
  AUD
  SGD
  INR
  PKR
  BRL
  MXN
  COP
  IDR
  MYR
  PHP
  THB
  VND
  CNY
  NGN
  ZAR
  KES
  EGP
  QAR
  OMR
  GHS
  JMD
}

enum TaxTreatmentType {
  INCLUSIVE
  EXCLUSIVE
  REVERSE_CHARGE
  EXEMPT
}

enum TaxIdType {
  EIN
  SSN
  VAT
  TRN
  GSTIN
  ABN
  NTN
  CNPJ
  CPF
  RFC
  TIN
  GENERIC_TAX_ID
}

// Global Jurisdiction Reference Table
model Jurisdiction {
  id                    String        @id @default(uuid())
  countryCode           String        @unique // e.g. "US", "GB", "AE", "PK"
  countryName           String
  governingLawName      String        // e.g. "ESIGN Act (2000) & UETA"
  lawAbbreviation       String        // e.g. "US ESIGN"
  arbitrationAct        String        // e.g. "American Arbitration Association (AAA) / Federal Arbitration Act"
  defaultCurrency       CurrencyCode  @default(USD)
  taxIdLabel            String        // e.g. "EIN / SSN"
  nationalIdLabel       String        // e.g. "Government ID"
  certificateNotice     String
  disputeResolutionClause String     @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  contracts             Contract[]

  @@map("jurisdictions")
}

enum DeliverableType {
  IMAGE_POST
  REEL
  STORY
  CAROUSEL_POST
  LIVE_SESSION
  AD
  YOUTUBE_VIDEO
  TIKTOK_VIDEO
}

enum SignerRole {
  CREATOR
  BRAND
  AGENCY
}

enum ReminderType {
  RESPONDENT_SIGN_REMINDER
  CONTRACT_EXPIRY_NOTICE
}

model User {
  id              String   @id @default(uuid())
  name            String
  phone           String?
  email           String   @unique
  instagramHandle String?  @map("instagram_handle")
  cnicNumber      String?  @map("cnic_number")
  cnicPhotoUrl    String?  @map("cnic_photo_url")
  supabaseAuthId  String?  @unique @map("supabase_auth_id")
  role            Role
  agencyName      String?  @map("agency_name")
  agencyAddress   String?  @map("agency_address")
  countryCode     String?  @default("US") @map("country_code")
  taxId           String?  @map("tax_id")
  designation     String?  @map("designation")
  creatorName     String?  @map("creator_name")
  isVerified      Boolean  @default(false) @map("is_verified")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  initiatedContracts Contract[] @relation("InitiatorContracts")
  respondedContracts Contract[] @relation("RespondentContracts")
  signatures         Signature[]
  auditLogs          AuditLog[]
  contractParties    ContractParty[]

  @@map("users")
}

model Contract {
  id                    String         @id @default(uuid())
  contractNumber        String         @unique @map("contract_number")
  verifyToken           String         @default(uuid()) @unique @map("verify_token")
  contractType          ContractType   @map("contract_type")

  // Phase 2 Jurisdiction Link
  jurisdictionCountryCode    String?             @map("jurisdiction_country_code")
  jurisdiction                Jurisdiction?       @relation(fields: [jurisdictionCountryCode], references: [countryCode])

  // Parties
  initiatorId           String         @map("initiator_id")
  initiator             User           @relation("InitiatorContracts", fields: [initiatorId], references: [id])
  respondentId          String?        @map("respondent_id")
  respondent            User?          @relation("RespondentContracts", fields: [respondentId], references: [id])

  // Link to parent contract (Agency→Creator links to Brand→Agency)
  linkedContractId      String?        @unique @map("linked_contract_id")
  linkedContract        Contract?      @relation("LinkedContracts", fields: [linkedContractId], references: [id])
  childContract         Contract?      @relation("LinkedContracts")

  status                ContractStatus @default(DRAFT)

  // Respondent details (filled by respondent via shared link)
  respondentName        String?        @map("respondent_name")
  respondentEmail       String?        @map("respondent_email")
  respondentPhone       String?        @map("respondent_phone")
  respondentCompany     String?        @map("respondent_company")
  respondentAddress     String?        @map("respondent_address")
  respondentDesignation String?        @map("respondent_designation")
  collabDetails         String?        @map("collab_details")

  // Financial
  currency              CurrencyCode   @default(USD)
  totalAmount           Decimal        @map("total_amount")
  advancePayment        Decimal?       @map("advance_payment")
  advancePaymentDate    DateTime?      @map("advance_payment_date")
  remainingAmount       Decimal?       @map("remaining_amount")
  remainingPaymentDate  DateTime?      @map("remaining_payment_date")
  paymentMethod         PaymentMethod? @map("payment_method")
  paymentRoutingDetails Json?          @map("payment_routing_details")
  bankAccountIban       String?        @map("bank_account_iban")
  mobileWalletNumber    String?        @map("mobile_wallet_number")
  advanceReceived       Boolean        @default(false) @map("advance_received")

  // Tax Engine
  taxTreatment          TaxTreatmentType @default(INCLUSIVE) @map("tax_treatment")
  taxRatePct            Decimal?         @default(0.00) @map("tax_rate_pct")
  taxAmount             Decimal?         @default(0.00) @map("tax_amount")
  isReverseCharge       Boolean          @default(false) @map("is_reverse_charge")

  // Delivery
  deliveryTimeframeDays Int            @map("delivery_timeframe_days")

  // Usage Rights
  platformsAllowed      String[]       @map("platforms_allowed")
  usageType             UsageType[]    @map("usage_type")
  usageRightsDuration   String         @map("usage_rights_duration")

  // Revision & Approval
  revisionRounds        Int            @default(1) @map("revision_rounds")
  revisionTurnaroundDays Int           @default(5) @map("revision_turnaround_days")
  brandApprovalRequired Boolean        @default(false) @map("brand_approval_required")

  // Exclusivity & NDA
  exclusivityClause           Boolean        @default(false) @map("exclusivity_clause")
  exclusivityDuration         String?        @map("exclusivity_duration")
  exclusivityCompetitors      String?        @map("exclusivity_competitors")
  confidentialityRequired     Boolean        @default(false) @map("confidentiality_required")
  embargoDate                 DateTime?      @map("embargo_date")
  earlyDisclosurePenalty      Decimal?       @map("early_disclosure_penalty")

  // Bilateral Penalties & Safeguards
  latePaymentPenaltyPct       Decimal        @default(3) @map("late_payment_penalty_pct")
  lateContentPenaltyPct       Decimal        @default(3) @map("late_content_penalty_pct")
  penaltyCapPct               Decimal        @default(20) @map("penalty_cap_pct")
  unauthorizedUsagePenaltyPct Decimal        @default(50) @map("unauthorized_usage_penalty_pct")
  advanceRefundable           Boolean        @default(true) @map("advance_refundable")
  advanceRefundTimeframeDays  Int            @default(7) @map("advance_refund_timeframe_days")
  nonDeliveryCutoffDays       Int            @default(7) @map("non_delivery_cutoff_days")
  cancellationFeePct          Decimal        @default(25) @map("cancellation_fee_pct")

  // Content & Tagging
  contentOwnership      String         @default("Creator retains copyright; brand receives usage license as defined.") @map("content_ownership")
  taggingRequirements   String?        @map("tagging_requirements")

  // Sharing
  shareToken            String         @unique @default(uuid()) @map("share_token")

  // Timestamps
  expiresAt             DateTime?      @map("expires_at")
  activatedAt           DateTime?      @map("activated_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  // Document integrity
  documentHash          String?        @map("document_hash")
  pdfUrl                String?        @map("pdf_url")

  // Initiator Party details (Business vs Individual based on role)
  initiatorDesignation      String?        @map("initiator_designation")
  initiatorPhone            String?        @map("initiator_phone")
  initiatorCompanyName      String?        @map("initiator_company_name")
  initiatorCompanyAddress   String?        @map("initiator_company_address")
  initiatorNtn              String?        @map("initiator_ntn")
  initiatorCnic             String?        @map("initiator_cnic")
  initiatorTaxIdType        TaxIdType?     @map("initiator_tax_id_type")
  initiatorTaxId            String?        @map("initiator_tax_id")
  initiatorNationalId       String?        @map("initiator_national_id")

  // Respondent identity fields
  respondentNtn             String?        @map("respondent_ntn")
  respondentCnic            String?        @map("respondent_cnic")
  respondentTaxIdType       TaxIdType?     @map("respondent_tax_id_type")
  respondentTaxId           String?        @map("respondent_tax_id")
  respondentNationalId      String?        @map("respondent_national_id")

  // Respondent payout details (separate from initiator payment terms)
  respondentPaymentMethod         PaymentMethod? @map("respondent_payment_method")
  respondentPaymentRoutingDetails Json?          @map("respondent_payment_routing_details")
  respondentBankAccountIban       String?        @map("respondent_bank_account_iban")
  respondentMobileWalletNumber    String?        @map("respondent_mobile_wallet_number")

  // Brand Campaign / Creator details for Agency contracts
  brandName             String?        @map("brand_name")
  brandHandle           String?        @map("brand_handle")
  campaignName          String?        @map("campaign_name")
  creatorName           String?        @map("creator_name")
  creatorHandle         String?        @map("creator_handle")

  // Collaboration Product details & Loan Return terms
  collabProduct                String?        @map("collab_product")
  collabProductProvisionType   String?        @map("collab_product_provision_type")
  collabDeliveryAddress        String?        @map("collab_delivery_address")
  collabDeliveryDate           DateTime?      @map("collab_delivery_date")
  collabProductReturnDays      Int?           @map("collab_product_return_days")
  collabProductReturnAddress   String?        @map("collab_product_return_address")
  collabProductReturnShippingBy String?       @map("collab_product_return_shipping_by")
  collabProductNonReturnFee    Decimal?       @map("collab_product_non_return_fee")

  // Cryptographic Hashes (3-Hash Architecture)
  contentHash                  String?        @map("content_hash")
  finalDocumentHash            String?        @map("final_document_hash")
  pdfBinaryHash                String?        @map("pdf_binary_hash")

  parties               ContractParty[]
  deliverables          Deliverable[]
  signatures            Signature[]
  auditLogs             AuditLog[]
  reminders             Reminder[]

  @@map("contracts")
  @@index([paymentMethod])
  @@index([jurisdictionCountryCode])
}

model Deliverable {
  id         String          @id @default(uuid())
  contractId String          @map("contract_id")
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type       DeliverableType
  quantity   Int             @default(1)
  duration      String?
  notes         String?

  @@map("deliverables")
}

model Signature {
  id                String    @id @default(uuid())
  contractId        String    @map("contract_id")
  contract          Contract  @relation(fields: [contractId], references: [id])
  signerId          String?   @map("signer_id")
  signer            User?     @relation(fields: [signerId], references: [id])
  signerRole        SignerRole @map("signer_role")
  signatureImageUrl String    @map("signature_image_url")
  signedAt          DateTime  @default(now()) @map("signed_at")
  ipAddress         String    @map("ip_address")
  userAgent         String    @map("user_agent")
  deviceFingerprint String?   @map("device_fingerprint")
  documentHash      String    @map("document_hash")
  signingEventHash  String?   @map("signing_event_hash")
  otpVerified       Boolean   @default(false) @map("otp_verified")
  otpEmail          String?   @map("otp_email")
  consentRecorded   Boolean   @default(true) @map("consent_recorded")

  signerPartyId     String?        @unique @map("signer_party_id")
  signerParty       ContractParty? @relation("PartySignature", fields: [signerPartyId], references: [id])

  @@map("signatures")
}

model AuditLog {
  id         String    @id @default(uuid())
  contractId String?   @map("contract_id")
  contract   Contract? @relation(fields: [contractId], references: [id])
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id])
  action     String
  details    Json?
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Reminder {
  id          String       @id @default(uuid())
  contractId  String       @map("contract_id")
  contract    Contract     @relation(fields: [contractId], references: [id])
  type        ReminderType
  scheduledAt DateTime     @map("scheduled_at")
  sentAt      DateTime?    @map("sent_at")
  status      String       @default("pending")

  @@map("reminders")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  code      String   // 6-digit code
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  attempts  Int      @default(0) // max 5 attempts
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

model ContractParty {
  id                    String         @id @default(uuid())
  contractId            String         @map("contract_id")
  contract              Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  partyType             PartyType      @map("party_type")
  
  userId                String?        @map("user_id")
  user                  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  name                  String
  email                 String
  phone                 String?
  role                  Role
  designation           String?
  
  companyName           String?        @map("company_name")
  companyAddress        String?        @map("company_address")
  ntn                   String?
  cnic                  String?
  taxIdType             TaxIdType?     @map("tax_id_type")
  taxId                 String?        @map("tax_id")
  nationalId            String?        @map("national_id")
  
  paymentMethod         PaymentMethod? @map("payment_method")
  paymentRoutingDetails Json?          @map("payment_routing_details")
  bankAccountIban       String?        @map("bank_account_iban")
  mobileWalletNumber    String?        @map("mobile_wallet_number")

  signature             Signature?     @relation("PartySignature")

  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@map("contract_parties")
  @@index([contractId])
  @@index([userId])
}

model SurveyResponse {
  id              String   @id @default(uuid())
  country         String
  currency        String
  earningsBracket String   @map("earnings_bracket")
  platform        String?  // backwards compatible fallback
  platforms       String[] @map("platforms")
  deliverables    Json?    @map("deliverables")
  niche           String
  followerTier    String   @map("follower_tier")
  engagementRate  String   @map("engagement_rate")
  dealScope       String[] @map("deal_scope")
  email           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("survey_responses")
  @@index([country])
}

// ==========================================
// YOUTUBE SCRAPER & CREATOR DATA TABLE
// ==========================================

model YouTubeScrape {
  id                    String    @id @default(uuid())
  youtubeChannelId      String    @map("youtube_channel_id")
  handle                String?
  title                 String
  customUrl             String?   @map("custom_url")
  description           String?   @db.Text
  country               String?
  avatarUrl             String    @map("avatar_url")
  extractedEmail        String?   @map("extracted_email")
  
  // Channel Lifetime Metrics
  subscriberCount       BigInt    @default(0) @map("subscriber_count")
  lifetimeViewCount     BigInt    @default(0) @map("lifetime_view_count")
  videoCount            Int       @default(0) @map("video_count")
  avgViewsPerVideo      BigInt    @default(0) @map("avg_views_per_video")
  
  // All Arrays & Nested Content (JSONB)
  externalLinks         Json      @default("[]") @map("external_links") // All profile links & domains
  longVideos            Json      @default("[]") @map("long_videos")     // 10 long videos + top comments
  shortVideos           Json      @default("[]") @map("short_videos")    // 10 shorts + top comments
  stats                 Json?     @map("stats")                          // Average views & engagement %
  keywords              String[]  @default([])
  topicCategories       String[]  @default([]) @map("topic_categories")
  uploadsPlaylistId     String?   @map("uploads_playlist_id")
  
  // AI Multi-Niche & Brand Summary Enrichment
  primaryNicheId        Int?      @map("primary_niche_id")
  primaryNicheName      String?   @map("primary_niche_name")
  secondaryNiches       Json?     @map("secondary_niches")
  aiCreatorSummary      String?   @db.Text @map("ai_creator_summary")
  detectedCountry       String?   @map("detected_country")
  
  // Complete Raw Metadata Backup
  rawMetadata           Json?     @map("raw_metadata")
  
  lastScrapedAt         DateTime  @default(now()) @map("last_scraped_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([handle])
  @@index([youtubeChannelId])
  @@index([primaryNicheId])
  @@index([youtubeChannelId, createdAt(sort: Desc)])
  @@map("youtube_scrapes")
}

// ==========================================
// INSTAGRAM SCRAPER & CREATOR DATA TABLE
// ==========================================

model InstagramScrape {
  id                    String    @id @default(uuid())
  instagramUsername     String    @map("instagram_username")
  instagramUserId       String?   @map("instagram_user_id")
  fullName              String?   @map("full_name")
  biography             String?   @db.Text
  avatarUrl             String    @map("avatar_url")
  isVerified            Boolean   @default(false) @map("is_verified")
  isBusinessAccount     Boolean   @default(false) @map("is_business_account")
  extractedEmail        String?   @map("extracted_email")
  externalUrls          Json      @default("[]") @map("external_urls")
  categoryName          String?   @map("category_name")
  
  // Follower & Profile Metrics
  followerCount         BigInt    @default(0) @map("follower_count")
  followingCount        Int       @default(0) @map("following_count")
  postsCount            Int       @default(0) @map("posts_count")
  avgEngagementRate     Float     @default(0) @map("avg_engagement_rate")
  
  // Content & Highlights (JSONB)
  highlights            Json      @default("[]") @map("highlights")
  posts                 Json      @default("[]") @map("posts") // 10-12 recent posts with likes, comments, captions
  stats                 Json?     @map("stats")                 // Average likes, average comments, engagement rate
  
  // AI Multi-Niche & Brand Summary Enrichment
  primaryNicheId        Int?      @map("primary_niche_id")
  primaryNicheName      String?   @map("primary_niche_name")
  secondaryNiches       Json?     @map("secondary_niches")
  aiCreatorSummary      String?   @db.Text @map("ai_creator_summary")
  detectedCountry       String?   @map("detected_country")
  
  // Raw Data Backup
  rawMetadata           Json?     @map("raw_metadata")
  
  lastScrapedAt         DateTime  @default(now()) @map("last_scraped_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([instagramUsername])
  @@index([primaryNicheId])
  @@index([instagramUsername, createdAt(sort: Desc)])
  @@map("instagram_scrapes")
}

// ==========================================
// TIKTOK SCRAPER & CREATOR DATA TABLE
// ==========================================

model TikTokScrape {
  id                    String    @id @default(uuid())
  tiktokUsername        String    @map("tiktok_username")
  nickname              String?   @map("nickname")
  biography             String?   @db.Text
  avatarUrl             String    @map("avatar_url")
  isVerified            Boolean   @default(false) @map("is_verified")
  isCommerceUser        Boolean   @default(false) @map("is_commerce_user")
  bioLink               String?   @map("bio_link")
  
  // Follower & Profile Metrics
  followerCount         BigInt    @default(0) @map("follower_count")
  followingCount        Int       @default(0) @map("following_count")
  heartCount            BigInt    @default(0) @map("heart_count")
  videoCount            Int       @default(0) @map("video_count")
  avgEngagementRate     Float     @default(0) @map("avg_engagement_rate")
  
  // Videos & Statistics (JSONB)
  videos                Json      @default("[]") @map("videos") // 12-23 recent videos with views, likes, comments, shares
  stats                 Json?     @map("stats")                 // Average views, likes, shares, engagement rate
  
  // AI Multi-Niche & Brand Summary Enrichment
  primaryNicheId        Int?      @map("primary_niche_id")
  primaryNicheName      String?   @map("primary_niche_name")
  secondaryNiches       Json?     @map("secondary_niches")
  aiCreatorSummary      String?   @db.Text @map("ai_creator_summary")
  detectedCountry       String?   @map("detected_country")
  
  // Raw Data Backup
  rawMetadata           Json?     @map("raw_metadata")
  
  lastScrapedAt         DateTime  @default(now()) @map("last_scraped_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([tiktokUsername])
  @@index([primaryNicheId])
  @@index([tiktokUsername, createdAt(sort: Desc)])
  @@map("tiktok_scrapes")
}




