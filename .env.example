# Brand & Identity Config
NEXT_PUBLIC_COMPANY_NAME="SignCollab"
NEXT_PUBLIC_COMPANY_DOMAIN="www.signcollab.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@signcollab.com"
NEXT_PUBLIC_LEGAL_COMPANY_INFO="SignCollab Legal Entity Name, Pakistan"

# Database Configuration (Prisma 7 uses these configuration parameters)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brandbridge?schema=public"

# Private AWS S3 storage (server-only)
AWS_REGION="your-aws-region"
S3_BUCKET_NAME="your-private-bucket-name"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Legacy storage migration only; keep until existing files have been copied and verified.
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Local Google login trial (server-only; do not commit real credentials)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-secure-random-secret"
GOOGLE_CLIENT_ID="your-web-client.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration
RESEND_API_KEY="re_yourkey"
# Optional contact form overrides. Defaults to NEXT_PUBLIC_SUPPORT_EMAIL and
# support@<company domain> (with the www prefix removed).
# CONTACT_TO_EMAIL="support@signcollab.com"
# CONTACT_FROM_EMAIL="support@signcollab.com"
# CONTACT_MAX_PER_IP_PER_HOUR="5"
# CONTACT_MAX_PER_DAY="50"
